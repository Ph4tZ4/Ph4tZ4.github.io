# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Firebase Admin (service account) — needed only for admin write access.
# Option A: path to a service account JSON file (relative to apps/api).
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option B: inline credentials (use instead of the file above).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Escape newlines as \n when pasting the private key on one line.
FIREBASE_PRIVATE_KEY=

# Comma-separated emails allowed to perform admin writes.
# Leave blank to allow ANY authenticated Firebase user (fine for a single-user portfolio).
ADMIN_EMAILS=
